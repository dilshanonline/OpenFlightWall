# -------------------------------------------------------
# OpenFlightWall — optional OpenSky credentials
# -------------------------------------------------------
# The app works WITHOUT this file (anonymous OpenSky access), but the anonymous
# rate limit is very low. Register a free account at https://opensky-network.org,
# create an API client, and paste the credentials below to get a higher limit.
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env

OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# -------------------------------------------------------
# Update check
# -------------------------------------------------------
# On startup (and in the browser) the app asks GitHub whether a newer release
# exists and shows a small banner if so. Set to 0 to never contact GitHub.
# OFW_UPDATE_CHECK=0

# -------------------------------------------------------
# Development and storage
# -------------------------------------------------------
# Turn on Flask's debugger and auto-reload. For development only: the debugger
# can run code from the browser.
# FLASK_DEBUG=1

# Folder for credentials saved from the Settings panel (default: next to app.py).
# OFW_DATA_DIR=/path/to/folder
